# Filled in automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Shared secret between Next.js and Convex. Generate with:
#   openssl rand -base64 32
# Must also be set on the Convex deployment:
#   npx convex env set AUTH_SECRET <value>
AUTH_SECRET=

# WebAuthn relying party — defaults work for localhost; set for production.
# WEBAUTHN_RP_ID=summit.example.com
# WEBAUTHN_ORIGIN=https://summit.example.com
